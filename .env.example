# ─────────────────────────────────────────────────────────────────────────────
#  Callypso Studio — .env.example. Copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you. Every key is
#  OPTIONAL — with none set, Callypso Studio runs in DEMO MODE with a sample
#  catalog and mock generated creatives.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── fal.ai — generates product creatives, lifestyle scenes & clean cut-outs ──
# https://fal.ai/dashboard/keys
FAL_KEY=

# ── Shopify — syncs products & pushes approved creatives to the store ────────
# TODO(real integration): not wired up in this first phase. ikas and Meta Ads
# sync are also on the roadmap and intentionally left unbuilt for now.
# https://shopify.dev/docs/apps/auth/admin-app-access-tokens
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ── Supabase — stores products, brand profiles, locked templates & shots ─────
# (optional)
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo mode — true renders sample data + toasts instead of real writes ─────
NEXT_PUBLIC_DEMO_MODE=true
