# ─────────────────────────────────────────────────────────────────────────────
#  Pixmint — .env.example. Copy to .env.local and fill in.
#
#  The guided setup ("/setup" in Claude Code) does this FOR you. Every key is
#  OPTIONAL — with none set, Pixmint runs in DEMO MODE with a sample catalog.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── fal.ai — generates product shots, lifestyle scenes & clean cut-outs ──────
# https://fal.ai/dashboard/keys
FAL_KEY=

# ── Shopify — syncs products & pushes approved shots to the store ────────────
# https://shopify.dev/docs/apps/auth/admin-app-access-tokens
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ── Supabase — stores products, brand kits & generated shots (optional) ──────
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
